gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Keystores are ignored by default — NEVER commit a production key.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# EXCEPTION (demo/testing only): a self-signed keystore is committed so CI can
# produce a directly-installable, consistently-signed release APK without repo
# secrets. Rotate to a secret-managed key before any real Play Store release.
!key.properties
!app/anaqatuk-release.jks
