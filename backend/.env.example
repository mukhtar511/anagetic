APP_NAME=Anaqatuk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Dev/CI can use sqlite; production uses MySQL 8.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=anaqatuk
# DB_USERNAME=anaqatuk
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Queues & cache (Redis in production) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Broadcasting (chat / smart-request offers / notifications) ---
# Soketi speaks the Pusher protocol; point Laravel Echo at it.
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=anaqatuk
PUSHER_APP_KEY=anaqatuk-key
PUSHER_APP_SECRET=anaqatuk-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# --- File storage (S3-compatible; local driver in dev) ---
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@anaqatuk.sa"
MAIL_FROM_NAME="${APP_NAME}"

# --- Anaqatuk drivers (swappable — SPEC §1) ---
# payment: fake | moyasar | neoleap        (fake in dev)
ANAQATUK_PAYMENT_DRIVER=fake
# sms:     fake | (provider)               (fake accepts dev OTP 1111 outside production)
ANAQATUK_SMS_DRIVER=fake
# ai:      mock | vision                   (mock returns the prototype auto-fill)
ANAQATUK_AI_DRIVER=mock

# --- Push notifications (FCM behind NotificationChannel) ---
FCM_SERVER_KEY=
FCM_PROJECT_ID=

VITE_APP_NAME="${APP_NAME}"
